# Raw data (large CSVs, not committed)
data/raw/*.csv

# Processed and feature data
data/processed/*
data/features/*

# Allow runtime files required by deployment
!data/processed/merged.parquet
!data/processed/_manifest.json

!data/features/train.parquet
!data/features/validation.parquet
!data/features/test.parquet

# Trained models
/models/*

# Allow production runtime models
!/models/production/
!/models/production/model.pkl
!/models/production/calibrated_model.pkl
!/models/production/model_card.json
!/models/production/feature_importance.json

# Artifacts (regenerated by pipeline)
artifacts/*
!artifacts/risk/
!artifacts/risk/device_risk_snapshot.parquet

# Environment secrets
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
.next/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

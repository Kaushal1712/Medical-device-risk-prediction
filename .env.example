# =============================================================================
# Medical Device Failure Risk Prediction System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# --- Data Paths (defaults are used if not set) ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
FEATURES_DATA_DIR=data/features

# --- Model Paths ---
MODELS_DIR=models
PRODUCTION_MODEL_DIR=models/production
EXPERIMENT_MODEL_DIR=models/experiments

# --- Artifacts ---
ARTIFACTS_DIR=artifacts

# --- LLM / GenAI Copilot Configuration ---
LLM_PROVIDER=          # e.g., openai, google, anthropic
LLM_API_KEY=           # your API key (never commit this)
LLM_MODEL_NAME=        # e.g., gpt-4o-mini, gemini-1.5-flash

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# --- Random Seed (for reproducibility) ---
RANDOM_SEED=42

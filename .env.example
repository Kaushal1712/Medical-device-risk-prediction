# =============================================================================
# Medical Device Failure Risk Prediction System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# --- Data Paths (defaults are used if not set) ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
FEATURES_DATA_DIR=data/features

# --- Model Paths ---
MODELS_DIR=models
PRODUCTION_MODEL_DIR=models/production
EXPERIMENT_MODEL_DIR=models/experiments

# --- Artifacts ---
ARTIFACTS_DIR=artifacts

# --- LLM / GenAI Copilot Configuration (Stage 9) ---
# Set LLM_PROVIDER to exactly one supported value: "openai" or "gemini"
# Leave blank (or omit) to use the deterministic template fallback with no external call.
# The copilot endpoint always degrades gracefully — a missing or failing LLM key
# never breaks the API or the Streamlit demo.
#
# For OpenAI:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_MODEL_NAME=gpt-4o-mini          # or gpt-4o, gpt-3.5-turbo, etc.
#   Requires: pip install openai>=1.0.0
#
# For Google Gemini:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=AIza...
#   LLM_MODEL_NAME=gemini-1.5-flash     # or gemini-1.5-pro, gemini-pro, etc.
#   Requires: pip install google-generativeai>=0.7.0
#
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_NAME=

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# --- Random Seed (for reproducibility) ---
RANDOM_SEED=42
